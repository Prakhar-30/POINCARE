# Supabase (publishable / anon key only — never the service key)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# WalletConnect / Reown project id (optional in dev; injected wallets work without it).
# Get one free at https://cloud.reown.com
VITE_WALLETCONNECT_PROJECT_ID=

# PoincareDCA address (optional). A public contract address, safe in the bundle. Overrides
# the `dca` entry in src/config/contracts.ts, e.g. to try a fresh deployment locally.
VITE_POINCARE_DCA_ADDRESS=

# ---------------------------------------------------------------------------
# Detector narration (optional)
# ---------------------------------------------------------------------------
# The Gemini key is NOT set here: anything VITE_-prefixed ships in the browser
# bundle. It lives as a Supabase edge-function secret instead, and the client
# reaches it through the `explain` function using the anon key above.
#
#   supabase functions deploy explain --no-verify-jwt
#   supabase secrets set GEMINI_API_KEY=...
#   supabase secrets set GEMINI_MODEL=gemini-3.6-flash   # optional
#
# With no key configured the Analytics regime panel falls back to its
# deterministic local narration, and says so in the UI.

# ---------------------------------------------------------------------------
# Product analytics: PostHog (optional; off when the key is empty)
# ---------------------------------------------------------------------------
# Free tier at https://posthog.com: create a project, copy its Project API key (phc_...).
# The key is public by design (it can only send events), so VITE_ is fine. Cookieless,
# anonymous, Do Not Track respected, no wallet addresses sent: see src/lib/telemetry.ts.
VITE_POSTHOG_KEY=
# US cloud by default; for an EU project use https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
