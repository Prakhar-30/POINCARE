# Compiler files
cache/
out/

# Ignores development (and goerli) broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/*/5/
/broadcast/**/dry-run/

# Docs
docs/

# Dotenv file
.env

# Node modules
node_modules/

# Local build brief — kept local, never tracked
CLAUDE.md

# Local probes only. The replay/trend drivers ARE tracked: they are how the live demo
# pool is driven and how the detector is made to fire on chain, so a reviewer needs them.
# Both read the key from $PK and Supabase creds from frontend/.env — never hardcoded.
frontend/probe*.mjs
# Supabase CLI scratch (version cache, local link state)
frontend/supabase/.temp/

# Parallel deploy-profile build output (see README section 10 / the deploy runbook): the
# default `forge test` profile overwrites out/ with unoptimized, over-EIP-170 artifacts, so
# the deploy build is kept in its own directory rather than racing for out/.
out-deploy/
cache-deploy/
