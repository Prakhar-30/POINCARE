{
  "name": "@poincaretrade/api",
  "version": "0.1.0",
  "description": "Poincaré HTTP API and DCA keeper, built for Supabase edge functions (bundled into frontend/supabase/functions/_shared).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle:edge": "tsup --config tsup.edge.config.ts && node scripts/check-edge-bundle.mjs"
  },
  "dependencies": {
    "@poincaretrade/sdk": "workspace:*",
    "viem": "2.53.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
